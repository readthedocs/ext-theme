// Dark theme overrides for global level elements
.dark-theme-override({
  body {
    background-color: darken(@black, 8);
    color: @invertedTextColor;
  }
});

// Knockout default styles
//
// Note: repeating a selector like this is a way to beef up specificity without
// chaining more selectors. This rule will override most 3 and 4 selector rules
// due to the artificially increased specificity in this rule.
.ko.ko.ko.ko.ko {
  // Documented in the stylesheet reference:
  // https://docs.ops.verbthenouns.com/projects/ext-theme/en/latest/api/stylesheets.html#knockout-visible-binding
  &.hidden {
    display: none;
  }
}

// The rebuild control of an uploaded version is disabled but keeps its
// tooltip, so it needs pointer events that Fomantic removes from disabled
// buttons and menu items.
readthedocs-menu-build-rebuild[uploaded] {
  &.ui.disabled.button,
  &.disabled.item {
    pointer-events: auto !important;
  }
}
