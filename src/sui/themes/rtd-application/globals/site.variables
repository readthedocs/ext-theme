// Don't show required fields as invalid on initial form display. There is an
// issue that will be closed by FUI 2.9.3:
// https://github.com/fomantic/Fomantic-UI/issues/2749
@variationInputInvalid: false;
@variationFormInvalid: false;

// Variable for high specificity `.ui` selector, a shortcut to increase
// specificity (1, 1, 0), which should be a higher specificity than any of the
// base SUI rule selectors. `#_` is just a short, non-existant id.
//
// Use this as a selector variable:
//
// @{uiImportant}.small.header { ... }
//
// prettier-ignore
@uiImportant: .ui:not(#_);

// Style overrides
// Highlight/select colors
@highlightBackground: @secondaryBackground;
@highlightColor: @secondaryTextColor;
@inputHighlightBackground: @secondaryBackground;
@inputHighlightColor: @secondaryTextColor;

// Color definitions for variations
//
// We don't use some of the default colors, which are a bit too neon colored by
// default. There are a number of color variables we're not setting though,
// which should probably be mapped out a bit more thoroughly.
//
// TODO move these to the common theme
@primaryColor: @teal;
@secondaryColor: @violet;
@linkColor: @primaryColor;

@lightTeal: mix(@teal, #fff, 80%);
@lightViolet: mix(@violet, #fff, 80%);

@lightPrimaryColor: @lightTeal;
@lightSecondaryColor: @lightViolet;
@lightPrimaryColorHover: @primaryColor;
@lightSecondaryColorHover: @secondaryColor;

@primaryBackground: @lightTeal;
@secondaryBackground: @lightViolet;
@primaryHoverTextColor: @primaryTextColor;
@secondaryHoverTextColor: @secondaryTextColor;

// Less aggressive inverted shadow on floating boxes and menus. This affects
// toasts, dropdowns, popups, etc.
@invertedFloatingShadow:
  0 2px 4px 0 rgba(225, 225, 225, 0.15),
  0 2px 10px 0 rgba(225, 225, 225, 0.1);
