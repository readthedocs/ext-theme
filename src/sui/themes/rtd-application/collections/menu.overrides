// A helper from grid to hide some of the top navigation menu items as the
// viewport narrows
@media only screen and (max-width: @largestTabletScreen) {
  .ui.ui.ui.menu > .computer.only.item,
  .ui.ui.ui.menu > .menu > .computer.only.item {
    display: none;
  }
}

.dark-theme-override({
  .ui.attached.menu,
  .ui.vertical.menu {
    &:not(.borderless):not(.text) {
      border: 1px solid rgba(255, 255, 255, 0.15);
    }
  }
});

// Nested link inside the build detail "Raw log" item, opens the plain text log
.ui.menu .item > a.raw.log.txt {
  margin-left: 0.5em;
  color: inherit;
  opacity: 0.6;

  &:hover {
    opacity: 1;
  }
}
