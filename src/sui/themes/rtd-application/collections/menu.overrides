// A helper from grid to hide some of the top navigation menu items as the
// viewport narrows
@media only screen and (max-width: @largestTabletScreen) {
  .ui.ui.ui.menu > .computer.only.item,
  .ui.ui.ui.menu > .menu > .computer.only.item {
    display: none;
  }
}

.dark-theme-override({
  .ui.attached.menu,
  .ui.vertical.menu {
    &:not(.borderless):not(.text) {
      border: 1px solid rgba(255, 255, 255, 0.15);
    }
  }
});

// Dropdown items can't use ``active`` to look selected, SUI treats that class
// as the dropdown being open. ``current`` gets the same look as an active item.
.ui.menu .current.dropdown.item {
  background: @activeItemBackground;
  color: @activeItemTextColor;
  font-weight: @activeItemFontWeight;
  box-shadow: @activeItemBoxShadow;
}
