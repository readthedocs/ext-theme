.ui.fieldset.segment {
  padding-left: 0rem;
  padding-right: 0rem;
}

.ui.ui.ui.short.placeholder.segment {
  min-height: 9rem;
}

.ui.horizontally.scrolling.segment {
  max-height: fit-content;
  overscroll-behavior: auto;
}

// Dark theme fix, use transparent background for basic segments
.ui.inverted.basic.segment,
.ui.segments .ui.inverted.basic.segment,
.ui.inverted.basic.segments {
  background: @basicBackground;
}
// Bring back borders on attached segments, these are missing from inverted
.dark-theme-override({
  .ui.segments,
  .ui.segments .segment,
  .ui.segment {
    &[class*="top attached"] {
      border: @invertedPiledBorder;
      border-bottom: none;
    }
    &[class*="bottom attached"] {
      border: @invertedPiledBorder;
      border-top: none;
    }
  }
});
