/*
 * Avatar overlapping variant
 * ==========================
 *
 * Used to create stacking avatar bubbles for maintainer and team member lists.
 *
 * .. code:: html
 *
 *     <div class="ui overlapping avatar images">
 *       <img class="ui image" src="..." />
 *     </div>
 */
.ui.overlapping.avatar.images {
  margin-left: 0.25rem;
  > .ui.image,
  > a > .ui.image {
    width: 1.5rem;
    height: 1.5rem;
    margin-left: -0.5rem;
  }
}

// Used in the project/organization headers for now, to keep consistent line height
@microWidth: 26px;
.ui.micro.image {
  width: @microWidth;
  height: auto;
}

// Support web component for avatar
.avatarWidth(@size) {
  width: @size;
  // This adjusts the variable that determines the width the avatar sprite is render at
  --avatar-scale: @size / -4;
}

readthedocs-avatar.ui.image {
  display: inline-block;
  height: auto;
  &.rounded {
    overflow: hidden;
  }

  &.micro {
    .avatarWidth(@microWidth);
  }
  &.mini {
    .avatarWidth(@miniWidth);
  }
  &.tiny {
    .avatarWidth(@tinyWidth);
  }
  &.small {
    .avatarWidth(@smallWidth);
  }
  &.medium {
    .avatarWidth(@mediumWidth);
  }
  &.large {
    .avatarWidth(@largeWidth);
  }
  &.big {
    .avatarWidth(@bigWidth);
  }
  &.huge {
    .avatarWidth(@hugeWidth);
  }
  &.massive {
    .avatarWidth(@massiveWidth);
  }
}

// Dark theme fix, invertable images and handy for black and white SVGS.
.dark-theme-override({
  .ui.invertable.image {
    filter: invert(100) brightness(110);
  }
});

// Mostly just for QR codes like MFA codes
.ui.white.background.image {
  background: @white;
}

/*
 * Labeled image variant
 * =====================
 *
 * An image with a label next to it, used for the logo and site name on the
 * entrance pages. The stacked variant puts the label under the right edge of
 * the image instead, tucked into the space below it, so the header keeps the
 * logo at full size without growing in either direction.
 *
 * .. code:: html
 *
 *     <a class="ui labeled image" href="...">
 *       <img class="ui image" src="..." />
 *       <span class="ui label">Community</span>
 *     </a>
 *
 *     <a class="ui stacked labeled image" href="...">...</a>
 */
.ui.labeled.image {
  display: inline-flex;
  align-items: center;
  gap: 0.5em;

  > .ui.image,
  > .ui.label {
    flex: none;
  }

  &.stacked {
    flex-direction: column;
    align-items: flex-end;
    gap: 0;

    > .ui.label {
      margin-top: 0.25em;
      // Pull the label up into the padding below the image so it adds no height
      margin-bottom: -2.5em;
    }
  }
}
