.ui.popupcard.popup {
  padding: 0px;

  > .ui.card {
    box-shadow: none;
    border: none;
  }
}

.ui.popup > .ui.card > .content > .description {
  white-space: normal;
}

// Dark theme fix for pointing popup, inverted arrow color isn't supported by
// default. This is required to put a border around the popup.
.dark-theme-override({
  .ui.top.popup::before,
  .ui.bottom.popup::before,
  .ui.left.popup::before,
  .ui.right.popup::before,
  .ui.popup::before {
    box-shadow: @invertedArrowBoxShadow;
    background: @invertedBackground;
  }
});
