// Theme configuration for Read the Docs Business
//
// Same theme as ``theme.config``, with the primary and secondary colors
// swapped so the Business dashboard can be told apart from Community. These
// definitions share the scope of the site variables, so they take precedence.
@import (multiple) "theme.config";

@primaryColor: @violet;
@secondaryColor: @teal;

// Keep links teal: violet links read as visited links.
@linkColor: @teal;
